    }
  }
  .dola-toc-bottom {
    > ol {
      padding-left: 0;
      list-style: decimal;
      list-style-type: none;
      list-style-position: inherit;
      padding-left: 0;
      li {
        > a {
          padding: 5px 10px;
          display: inline-block;
          width: 100%;
           &:hover {
            background: var(--mainColor);
            color: #fff;
          }
        }
        .is-collapsible {
          list-style: decimal;
          list-style-type: circle;
          list-style-position: inherit;
          padding-left: 0;
          li {
            padding-left: 0;
            display: inline-block;
            width: 100%;
            a {
              padding-left: 30px;
              font-style: italic;
              position: relative;
              width: 100%;
               &:before {
                content: "";
                top: 13px;
                left: 15px;
                position: absolute;
                width: 9px;
                height: 9px;
                border: solid 2px #d7d7d7;
                border-radius: 50%;
              }
            }
            &.is-active-li {
              > a {
                background: var(--mainColor);
                color: #fff;
              }
            }
          }
        }
        &.is-active-li {
          > a {
            background: var(--mainColor);
            color: #fff;
          }
        }
      }
    }
  }
}
