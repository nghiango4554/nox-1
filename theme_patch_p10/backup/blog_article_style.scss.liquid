.nav-category {

  ul {
    padding: 0;
    margin: 0;
    list-style: none;

    .nav-item {
      .nav-link {
        display: block;
        padding: 8px 0;
        font-size: 16px;
        color: #fff;
        font-weight: 700;
        word-break: break-word;
        &.pr-5 {
          padding-right: 30px;
        }

      }
      .down_icon {
        height: 20px !important;
        width: 20px !important;
        position: absolute;
        right: 7.5px;
        top: 21px;
        transform: translate(0, -50%);
        cursor: pointer;
         &:after,
         &:before {
          position: absolute;
          content: '';
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) rotate(-90deg);
          background-color: #fff;
          transition: transform 0.4s ease-in-out
          , opacity 0.4s ease-in-out;
        }
         &:before {
          width: 11px;
          height: 1px;
          opacity: 1;
        }
         &:after {
          width: 1px;
          height: 11px;
        }
        &.cls_mn {
           &:after,
           &:before {
            background-color: var(--mainColor);
            transform: translate(-50%, -50%) rotate(90deg);
          }
           &:before {
            opacity: 0;
          }
        }
      }
      &.active,
       &:hover {
        > .nav-link {
          color: var(--hover);
        }
        > .down_icon {
           &:after,
           &:before {
            background-color: var(--hover);
          }
        }
      }
    }
    .menu_down {
      padding-left: 10px !important;
    }

  }
}
.blog-slider {
