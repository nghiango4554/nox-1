{% extends "base.html" %}
{% block title %}SP Haravan · Sintech Hub{% endblock %}

{% block page_title %}
<a href="{{ url_for('haravan_dashboard') }}" class="muted" style="font-weight:500">🛒 Haravan</a>
<span class="crumb"></span>
<span style="font-weight:600">Danh sách sản phẩm</span>
{% endblock %}

{% block page_actions %}
<a class="btn" href="{{ url_for('haravan_dashboard') }}">← Dashboard</a>
<form action="{{ url_for('haravan_sync_start') }}" method="post" style="display:inline">
  <button class="btn btn-primary" type="submit">🔄 Sync lại</button>
</form>
{% endblock %}

{% block content %}

{# ───── KPI ───── #}
<div class="kpi-grid">
  <div class="kpi">
    <div class="kpi-label">Tổng SP trong DB</div>
    <div class="kpi-num" style="font-size:28px">{{ stats.total }}</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Điểm trung bình</div>
    <div class="kpi-num" style="font-size:28px">{{ stats.avg_score }}</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">SP tốt (≥80)</div>
    <div class="kpi-num" style="font-size:28px;color:#4ade80">{{ stats.good }}</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Cần sửa (&lt;60)</div>
    <div class="kpi-num" style="font-size:28px;color:#f87171">{{ stats.bad }}</div>
  </div>
</div>

{# ───── TOP ISSUES ───── #}
{% if top_issues %}
<section class="card" style="margin-top:16px">
  <h3 style="margin-top:0">Top vấn đề (click để filter)</h3>
  <div class="seo-issue-chips">
    {% for it in top_issues %}
      <a href="?issue={{ it.code }}"
         class="seo-issue-chip seo-issue-{{ it.level }} {% if filters.issue_code == it.code %}active{% endif %}">
        <span>{{ it.icon }}</span>
        <span>{{ it.label }}</span>
        <span class="seo-issue-count">{{ it.count }}</span>
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ───── FILTER BAR ───── #}
<section class="card seo-filter-bar" style="margin-top:16px">
  <form method="get" class="seo-filter-form">
    <input type="text" name="q" value="{{ filters.search or '' }}"
           placeholder="🔍 Tìm theo title hoặc handle..." class="seo-filter-input">

    <select name="vendor" class="seo-filter-select">
      <option value="">Tất cả vendor</option>
      {% for v in stats.by_vendor.keys() %}
        <option value="{{ v }}" {% if filters.vendor == v %}selected{% endif %}>{{ v }}</option>
      {% endfor %}
    </select>

    <select name="type" class="seo-filter-select">
      <option value="">Tất cả loại</option>
      {% for t in stats.by_type.keys() %}
        <option value="{{ t }}" {% if filters.product_type == t %}selected{% endif %}>{{ t }}</option>
      {% endfor %}
    </select>

    <select name="status" class="seo-filter-select">
      <option value="">Tất cả status</option>
      <option value="active" {% if filters.status == 'active' %}selected{% endif %}>active</option>
      <option value="draft"  {% if filters.status == 'draft'  %}selected{% endif %}>draft</option>
    </select>

    <select name="band" class="seo-filter-select">
      <option value="">Tất cả điểm</option>
      <option value="bad"  {% if band == 'bad'  %}selected{% endif %}>🔴 Cần sửa (&lt;60)</option>
      <option value="ok"   {% if band == 'ok'   %}selected{% endif %}>🟡 OK (60-79)</option>
      <option value="good" {% if band == 'good' %}selected{% endif %}>🟢 Tốt (≥80)</option>
    </select>

    <select name="sort" class="seo-filter-select">
      <option value="score_asc"  {% if filters.sort == 'score_asc'  %}selected{% endif %}>Điểm tăng dần (sửa trước)</option>
      <option value="score_desc" {% if filters.sort == 'score_desc' %}selected{% endif %}>Điểm giảm dần</option>
      <option value="title"      {% if filters.sort == 'title'      %}selected{% endif %}>Title A→Z</option>
      <option value="recent"     {% if filters.sort == 'recent'     %}selected{% endif %}>Update gần nhất</option>
      <option value="synced"     {% if filters.sort == 'synced'     %}selected{% endif %}>Sync gần nhất</option>
    </select>

    {% if filters.issue_code %}
      <input type="hidden" name="issue" value="{{ filters.issue_code }}">
      <a href="?" class="btn btn-sm">✕ Bỏ filter "{{ filters.issue_code }}"</a>
    {% endif %}

    <button class="btn btn-primary" type="submit">Lọc</button>
    <a href="{{ url_for('haravan_products_page') }}" class="btn">Reset</a>
  </form>
</section>

{# ───── PRODUCT LIST ───── #}
<section class="card" style="margin-top:16px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
    <h3 style="margin:0">
      Danh sách
      <span class="muted" style="font-weight:400;font-size:14px">
        — {{ total }} kết quả
        {% if total_pages > 1 %} · trang {{ page_num }}/{{ total_pages }}{% endif %}
      </span>
    </h3>
  </div>

  {% if products %}
    <div class="table-wrap">
    <table class="table seo-table">
      <thead>
        <tr>
          <th class="col-stt">STT</th>
          <th>Sản phẩm</th>
          <th>Vendor</th>
          <th>Loại</th>
          <th>Status</th>
          <th>Giá (₫)</th>
          <th>Tồn</th>
          <th>Điểm</th>
          <th>Vấn đề</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        {% for p in products %}
        {% set issue_list = (p.audit_issues|from_json) if p.audit_issues else [] %}
        <tr>
          <td class="col-stt">{{ (page_num - 1) * 50 + loop.index }}</td>
          <td class="seo-url-cell">
            <div class="seo-url-title" style="font-weight:500;color:var(--text)">{{ p.title or '(không title)' }}</div>
            {% if p.handle %}
              <a href="https://sintech.vn/products/{{ p.handle }}" target="_blank" rel="noopener" class="seo-url-link">
                /{{ p.handle }}
              </a>
            {% endif %}
          </td>
          <td><small>{{ p.vendor or '—' }}</small></td>
          <td><small>{{ p.product_type or '—' }}</small></td>
          <td>
            {% if p.status == 'active' %}
              <span class="pill" style="background:rgba(34,197,94,0.15);color:#86efac">active</span>
            {% else %}
              <span class="pill" style="background:rgba(234,179,8,0.15);color:#fde68a">{{ p.status or '—' }}</span>
            {% endif %}
          </td>
          <td>
            <small>
              {% if p.price_min %}
                {{ "{:,.0f}".format(p.price_min) }}
                {% if p.price_max and p.price_max != p.price_min %}
                  – {{ "{:,.0f}".format(p.price_max) }}
                {% endif %}
              {% else %}—{% endif %}
            </small>
          </td>
          <td><small>{{ p.inventory_total or 0 }}</small></td>
          <td>
            {% if p.audit_score is not none %}
              {% if p.audit_score >= 80 %}
                <span class="seo-score seo-score-good">{{ p.audit_score }}</span>
              {% elif p.audit_score >= 60 %}
                <span class="seo-score seo-score-ok">{{ p.audit_score }}</span>
              {% else %}
                <span class="seo-score seo-score-bad">{{ p.audit_score }}</span>
              {% endif %}
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td>
            {% set errors = issue_list | selectattr('level', 'equalto', 'error') | list %}
            {% set warns  = issue_list | selectattr('level', 'equalto', 'warn')  | list %}
            {% if errors %}<span class="pill pill-error">{{ errors|length }} lỗi</span>{% endif %}
            {% if warns %}<span class="pill pill-warn">{{ warns|length }} cảnh báo</span>{% endif %}
            {% if not errors and not warns %}
              <span class="pill" style="background:rgba(34,197,94,0.15);color:#4ade80">tốt</span>
            {% endif %}
          </td>
          <td>
            <a href="{{ url_for('haravan_product_detail', haravan_id=p.haravan_id) }}" class="btn btn-sm">Chi tiết →</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>

    {% if total_pages > 1 %}
      {% set qs = request.args.to_dict() %}
      <div class="seo-pagination">
        {% if page_num > 1 %}
          {% set _ = qs.update({'page': page_num - 1}) %}
          <a class="btn btn-sm" href="?{{ qs|urlencode }}">← Trước</a>
        {% endif %}
        <span class="muted">Trang {{ page_num }}/{{ total_pages }}</span>
        {% if page_num < total_pages %}
          {% set _ = qs.update({'page': page_num + 1}) %}
          <a class="btn btn-sm" href="?{{ qs|urlencode }}">Sau →</a>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <p class="muted">
      Không có sản phẩm khớp filter.
      {% if stats.total == 0 %}
        Quay lại <a href="{{ url_for('haravan_dashboard') }}">Dashboard</a> bấm <strong>Sync</strong> để load SP.
      {% else %}
        Thử <a href="{{ url_for('haravan_products_page') }}">reset filter</a>.
      {% endif %}
    </p>
  {% endif %}
</section>

{% endblock %}
