{% extends "base.html" %}
{% block title %}Task Center · Sintech Hub{% endblock %}
{% block page_title %}<span style="font-weight:600">✅ Task Center</span>{% endblock %}
{% block page_actions %}
<button class="btn btn-primary" id="tc-gen" type="button">⚙️ Tạo task</button>
{% endblock %}
{% block content %}
<div id="tc-app"><div class="tc-skel"></div></div>
<style>
  .tc-skel{height:80px;border-radius:12px;background:linear-gradient(90deg,rgba(255,255,255,.04),rgba(255,255,255,.09),rgba(255,255,255,.04));background-size:200% 100%;animation:tcsh 1.2s infinite}
  @keyframes tcsh{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .tc-card{background:var(--surface,#1a1a1a);border:1px solid var(--border,rgba(255,255,255,.1));border-radius:12px;padding:14px 16px;margin-bottom:14px}
  .tc-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
  .tc-tab{background:var(--surface,#111);border:1px solid var(--border,rgba(255,255,255,.15));color:var(--text-muted,#94a3b8);border-radius:7px;padding:5px 11px;font-size:12px;cursor:pointer}
  .tc-tab.on{background:var(--accent,#7c3aed);color:#fff;border-color:transparent;font-weight:600}
  .tc-pill{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600}
  .b-ok{background:rgba(34,197,94,.15);color:#4ade80}.b-warn{background:rgba(245,158,11,.15);color:#fbbf24}
  .b-err{background:rgba(239,68,68,.15);color:#f87171}.b-gray{background:rgba(148,163,184,.15);color:#94a3b8}.b-info{background:rgba(59,130,246,.15);color:#60a5fa}
  .tc-task{border:1px solid var(--border,rgba(255,255,255,.08));border-radius:9px;padding:11px 13px;margin-bottom:9px;background:rgba(255,255,255,.02)}
  .tc-btn{background:var(--surface,#111);border:1px solid var(--border,rgba(255,255,255,.15));color:inherit;border-radius:7px;padding:3px 9px;font-size:11px;cursor:pointer}
</style>
{% endblock %}
{% block scripts %}
<script src="{{ url_for('static', filename='tasks_dashboard.js') }}?v={{ now.timestamp()|int }}"></script>
{% endblock %}
