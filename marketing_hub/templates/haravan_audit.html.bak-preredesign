{% extends "base.html" %}
{% block title %}Audit Haravan · Sintech Hub{% endblock %}
{% block content %}
<style>
  .au-kpis { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
  .au-kpi { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:12px 16px; min-width:120px; }
  .au-kpi .n { font-size:24px; font-weight:800; }
  .au-kpi .l { font-size:11.5px; color:var(--text-muted,#94a3b8); }
  .au-table { width:100%; border-collapse:collapse; font-size:12.5px; }
  .au-table th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--text-muted,#94a3b8); padding:8px; border-bottom:1px solid var(--border); }
  .au-table td { padding:8px; border-bottom:1px solid rgba(255,255,255,.05); vertical-align:top; }
  .au-m { font-family:monospace; font-weight:700; font-size:11px; padding:1px 6px; border-radius:5px; }
  .au-PUT { background:rgba(14,165,233,.18); color:#38bdf8; }
  .au-POST{ background:rgba(52,211,153,.18); color:#34d399; }
  .au-DELETE{ background:rgba(248,113,113,.18); color:#f87171; }
  .au-sum { color:var(--text-secondary,#cbd5e1); word-break:break-word; max-width:420px; }
  .au-err { color:#f87171; font-size:11.5px; }
</style>

<h1 style="font-size:20px;margin:0 0 4px">📜 Audit log Haravan</h1>
<p class="au-kpi" style="background:none;border:none;padding:0;margin:0 0 14px;color:var(--text-muted,#94a3b8);font-size:12px">Ghi lại mọi thay đổi (PUT/POST/DELETE) đẩy lên Haravan — bài nào, lúc nào, đổi gì, thành công hay lỗi.</p>

<div class="au-kpis">
  <div class="au-kpi"><div class="n">{{ stats.total }}</div><div class="l">Tổng thay đổi</div></div>
  <div class="au-kpi"><div class="n" style="color:#34d399">{{ stats.today }}</div><div class="l">Hôm nay</div></div>
  <div class="au-kpi"><div class="n" style="color:{{ '#f87171' if stats.fail else '#94a3b8' }}">{{ stats.fail }}</div><div class="l">Lỗi</div></div>
</div>

<div style="margin-bottom:10px;display:flex;gap:8px;align-items:center">
  <a class="btn btn-sm {% if not only_fail %}btn-primary{% endif %}" href="{{ url_for('haravan_audit_page') }}">Tất cả</a>
  <a class="btn btn-sm {% if only_fail %}btn-primary{% endif %}" href="{{ url_for('haravan_audit_page', fail=1) }}">❌ Chỉ lỗi</a>
</div>

<section class="card" style="padding:0;overflow-x:auto">
  {% if rows %}
  <table class="au-table">
    <thead><tr>
      <th style="width:140px">Thời gian</th><th style="width:64px">Method</th>
      <th style="width:160px">Tài nguyên</th><th>Thay đổi</th>
      <th style="width:90px">Kết quả</th>
    </tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td class="muted" style="white-space:nowrap">{{ (r.ts or '')[:19]|replace('T',' ') }}</td>
        <td><span class="au-m au-{{ r.method }}">{{ r.method }}</span></td>
        <td>
          {{ r.resource_type or '—' }}{% if r.resource_id %} <strong>#{{ r.resource_id }}</strong>{% endif %}
          {% if r.resource_type == 'product' and r.resource_id %}
          <a href="https://sintech.myharavan.com/admin/products/{{ r.resource_id }}" target="_blank" rel="noopener" style="font-size:11px;color:#60a5fa"> ↗</a>{% endif %}
        </td>
        <td class="au-sum">
          {{ r.summary or '—' }}
          {% if r.error %}<div class="au-err">⚠️ {{ r.error[:200] }}</div>{% endif %}
        </td>
        <td>{% if r.ok %}<span style="color:#34d399">✅ {{ r.status_code }}</span>{% else %}<span style="color:#f87171">❌ {{ r.status_code }}</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted" style="padding:24px;text-align:center;margin:0">Chưa có thay đổi nào được ghi{% if only_fail %} (lỗi){% endif %}. Mọi PUT/POST/DELETE lên Haravan từ giờ sẽ hiện ở đây.</p>
  {% endif %}
</section>

{% if rows|length >= page_size or page > 1 %}
<div style="display:flex;justify-content:center;gap:10px;padding:14px 0">
  {% set fq = '&fail=1' if only_fail else '' %}
  {% if page > 1 %}<a class="btn btn-sm" href="?page={{ page-1 }}{{ fq }}">‹ Trước</a>{% endif %}
  <span class="muted" style="font-size:12.5px;align-self:center">Trang {{ page }}</span>
  {% if rows|length >= page_size %}<a class="btn btn-sm" href="?page={{ page+1 }}{{ fq }}">Sau ›</a>{% endif %}
</div>
{% endif %}
{% endblock %}
