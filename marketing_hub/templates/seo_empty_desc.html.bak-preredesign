{% extends "base.html" %}
{% block title %}SP thiếu mô tả · SEO · Sintech Hub{% endblock %}

{% block page_title %}
<a href="{{ url_for('seo_dashboard') }}" class="muted" style="font-weight:500">🔍 SEO</a>
<span class="crumb"></span>
<span style="font-weight:600">📭 SP thiếu mô tả</span>
{% endblock %}

{% block page_actions %}
<a class="btn" href="{{ url_for('seo_dashboard') }}">← Quay lại SEO</a>
{% endblock %}

{% block content %}

<section class="card" style="margin-top:0">
  <p class="muted" style="margin:0">
    Quét HTML public các trang sản phẩm <code>/products/...</code> → đếm số từ trong container
    <code>.rte.product_getcontent</code> (phần mô tả em viết qua Haravan admin).
    SP có mô tả <strong>rỗng hoặc &lt; {{ threshold }} từ</strong> sẽ hiện ra để em bổ sung content.
  </p>
</section>

{# ───── KPI ───── #}
<div class="kpi-grid" style="margin-top:14px">
  <div class="kpi">
    <div class="kpi-row"><div class="kpi-icon" style="background:rgba(239,68,68,0.15);color:#f87171">📭</div></div>
    <div class="kpi-num" style="color:#f87171">{{ summary.empty }}</div>
    <div class="kpi-label">SP rỗng (0 từ)</div>
  </div>
  <div class="kpi">
    <div class="kpi-row"><div class="kpi-icon yellow">📝</div></div>
    <div class="kpi-num" style="color:#facc15">{{ summary.short }}</div>
    <div class="kpi-label">SP ngắn (&lt; {{ threshold }} từ)</div>
  </div>
  <div class="kpi">
    <div class="kpi-row"><div class="kpi-icon green">✅</div></div>
    <div class="kpi-num" style="color:#4ade80">{{ summary.ok }}</div>
    <div class="kpi-label">SP đạt (≥ {{ threshold }} từ)</div>
  </div>
  <div class="kpi">
    <div class="kpi-row"><div class="kpi-icon">🔢</div></div>
    <div class="kpi-num">{{ summary.scanned }}</div>
    <div class="kpi-label">Tổng đã quét</div>
  </div>
</div>

{# ───── SCAN FORM ───── #}
<section class="card" style="margin-top:16px">
  <h3 style="margin-top:0">🔎 Quét lại</h3>
  {% set scanning = state.running %}
  <form method="post" action="{{ url_for('seo_empty_desc_scan') }}" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
    <label class="muted" style="font-size:13px">Ngưỡng "thiếu mô tả" (từ):</label>
    <input type="number" name="threshold" min="0" max="1000" value="{{ threshold }}" style="width:90px">
    <label class="muted" style="font-size:13px;margin-left:12px">Limit:</label>
    <input type="number" name="limit" min="0" placeholder="0 = không giới hạn" style="width:140px">
    <button class="btn btn-primary" type="submit" {% if scanning %}disabled{% endif %}>
      {% if scanning %}⏳ Đang quét...{% else %}🚀 Bắt đầu quét{% endif %}
    </button>
  </form>

  {% if scanning or state.message %}
  <div style="margin-top:12px;padding:10px 12px;background:rgba(59,130,246,0.08);border-radius:8px;font-size:13px">
    <strong>Trạng thái:</strong> {{ state.message or '—' }}
    {% if state.total %}
    <div class="muted" style="margin-top:4px">
      Đã quét {{ state.checked }}/{{ state.total }} ·
      Rỗng: <strong style="color:#f87171">{{ state.empty }}</strong> ·
      Ngắn: <strong style="color:#facc15">{{ state.short }}</strong> ·
      OK: {{ state.ok }} ·
      Lỗi fetch: {{ state.failed }}
    </div>
    {% endif %}
  </div>
  {% endif %}
</section>

{# ───── FILTER + PUSH BULK ───── #}
<section class="card" style="margin-top:16px">
  <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
    <strong>Hiển thị:</strong>
    <a class="seo-issue-chip {% if not show_all %}seo-issue-error{% else %}seo-issue-info{% endif %}"
       href="{{ url_for('seo_empty_desc_page', threshold=threshold) }}">
      Cần sửa <span class="seo-issue-count">{{ summary.empty + summary.short }}</span>
    </a>
    <a class="seo-issue-chip {% if show_all %}seo-issue-info{% else %}seo-issue-warn{% endif %}"
       href="{{ url_for('seo_empty_desc_page', threshold=threshold, all=1) }}">
      👁️ Tất cả SP đã quét <span class="seo-issue-count">{{ summary.scanned }}</span>
    </a>
    <span style="flex:1"></span>
    <form action="{{ url_for('content_jobs_push_from_empty_desc') }}" method="post" style="display:inline">
      <input type="hidden" name="threshold" value="{{ threshold }}">
      <button class="btn btn-primary" type="submit"
              {% if (summary.empty + summary.short) == 0 %}disabled title="Không có SP nào để đẩy"{% endif %}
              onclick="return confirm('Đẩy {{ summary.empty + summary.short }} SP vào Content Jobs để AI viết content?')">
        📤 Đẩy {{ summary.empty + summary.short }} SP vào Content Jobs
      </button>
    </form>
  </div>
</section>

{# ───── TABLE ───── #}
<section class="card" style="margin-top:16px">
  {% if not items %}
  <p class="muted" style="margin:0;text-align:center;padding:24px">
    {% if summary.scanned == 0 %}
    Chưa có SP nào được quét. Bấm <strong>🚀 Bắt đầu quét</strong> ở trên để bắt đầu.
    {% else %}
    🎉 Không có SP nào thiếu mô tả (ngưỡng {{ threshold }} từ).
    {% endif %}
  </p>
  {% else %}
  <table class="data-table" style="font-size:13px">
    <thead>
      <tr>
        <th style="width:40px">#</th>
        <th>URL sản phẩm</th>
        <th style="width:100px;text-align:center">Số từ<br>mô tả</th>
        <th style="width:80px;text-align:center">Trạng thái</th>
        <th style="width:140px">Quét lúc</th>
        <th style="width:120px">Action</th>
      </tr>
    </thead>
    <tbody>
      {% for it in items %}
      {% set wc = it.desc_word_count or 0 %}
      <tr>
        <td class="muted">{{ loop.index }}</td>
        <td>
          <a href="{{ it.url }}" target="_blank" rel="noopener" style="word-break:break-all">
            {{ it.url|replace('https://sintech.vn', '') }}
          </a>
          {% if it.title %}
          <div class="muted" style="font-size:11px;margin-top:2px">{{ it.title[:120] }}</div>
          {% endif %}
        </td>
        <td style="text-align:center">
          {% if wc == 0 %}
            <strong style="color:#f87171">0</strong>
          {% elif wc < threshold %}
            <strong style="color:#facc15">{{ wc }}</strong>
          {% else %}
            <span style="color:#4ade80">{{ wc }}</span>
          {% endif %}
        </td>
        <td style="text-align:center">
          {% if wc == 0 %}
            <span style="color:#f87171">📭 Rỗng</span>
          {% elif wc < threshold %}
            <span style="color:#facc15">📝 Ngắn</span>
          {% else %}
            <span style="color:#4ade80">✅ OK</span>
          {% endif %}
        </td>
        <td class="muted" style="font-size:11px">{{ it.desc_empty_scanned_at or '—' }}</td>
        <td>
          {% if wc < threshold %}
          <form action="{{ url_for('content_jobs_push_one') }}" method="post" style="display:inline">
            <input type="hidden" name="url" value="{{ it.url }}">
            <input type="hidden" name="reason" value="{{ 'empty_desc' if wc == 0 else 'short_desc' }}">
            <button class="btn" type="submit" style="padding:3px 10px;font-size:11px"
                    title="Đẩy SP này vào Content Jobs">📤 Đẩy</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>

{% if state.running %}
<script>
  setTimeout(() => location.reload(), 5000);
</script>
{% endif %}

{% endblock %}
