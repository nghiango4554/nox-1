{% extends "base.html" %}
{% block title %}Blog Job Center · Sintech Hub{% endblock %}

{% block page_title %}
<span style="font-weight:700;letter-spacing:-.3px">Blog Job Center</span>
{% endblock %}

{% block page_actions %}
<a class="btn btn-sm" href="{{ url_for('blog_pillars_page') }}" style="font-size:12px">🏛️ Pillar Plan</a>
<button class="btn btn-sm" id="btn-batch" onclick="startBatchGen()"
        style="background:rgba(124,58,237,0.22);color:#c4b5fd;border-color:rgba(124,58,237,0.45);font-size:12px">
  ▶ Gen liên tục
</button>
<form method="post" action="{{ url_for('blog_content_sync_all') }}" style="display:inline"
      onsubmit="return confirm('Sync tất cả bài status=draft lên Haravan?');">
  <button class="btn btn-sm btn-primary" type="submit" style="font-size:12px">🚀 Sync all draft</button>
</form>
{% endblock %}

{% block content %}
<style>
/* ── Stats bar ── */
.jc-stats {
  display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:14px;
}
.jc-stat-pill {
  display:inline-flex; align-items:center; gap:5px; padding:5px 12px;
  border-radius:20px; font-size:12px; font-weight:500; cursor:pointer;
  text-decoration:none; color:inherit; border:1px solid transparent;
  background:rgba(255,255,255,0.04); transition:all .15s;
}
.jc-stat-pill:hover { background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,.12) }
.jc-stat-pill.active { background:rgba(124,58,237,0.2); border-color:rgba(124,58,237,0.5); color:#c4b5fd }
.jc-stat-pill .n { font-size:13px; font-weight:700 }
.jc-divider { width:1px; height:20px; background:rgba(255,255,255,.1); margin:0 4px }

/* ── Filter bar ── */
.jc-filters {
  display:flex; gap:6px; flex-wrap:wrap; align-items:center;
  margin-bottom:14px; padding:8px 12px;
  background:rgba(255,255,255,.02); border:1px solid rgba(255,255,255,.06);
  border-radius:8px;
}
.jc-filter-label { font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.5px; margin-right:2px }
.jc-chip {
  display:inline-flex; align-items:center; padding:3px 10px; border-radius:12px;
  font-size:11.5px; font-weight:500; cursor:pointer; text-decoration:none;
  color:var(--text-muted); border:1px solid transparent; transition:all .15s;
}
.jc-chip:hover { color:inherit; background:rgba(255,255,255,.06) }
.jc-chip.on { background:rgba(255,255,255,.09); color:#e2e8f0; border-color:rgba(255,255,255,.15) }

/* ── Table ── */
.jc-table { width:100%; border-collapse:collapse; font-size:12.5px }
.jc-table th {
  padding:9px 10px; text-align:left; font-size:10px; font-weight:600;
  color:var(--text-muted); text-transform:uppercase; letter-spacing:.5px;
  border-bottom:1px solid rgba(255,255,255,.07);
  background:rgba(255,255,255,.015); white-space:nowrap;
}
.jc-table th.r { text-align:right }
.jc-table td { padding:8px 10px; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:middle }
.jc-table tbody tr { transition:background .1s }
.jc-table tbody tr:hover { background:rgba(255,255,255,.035) }
.jc-table tbody tr:hover .jc-actions { opacity:1 }

/* status dot */
.jc-dot { width:7px; height:7px; border-radius:50%; display:inline-block; flex-shrink:0 }
.jc-dot-pending  { background:#64748b }
.jc-dot-drafting { background:#facc15 }
.jc-dot-draft    { background:#34d399 }
.jc-dot-synced   { background:#60a5fa }
.jc-dot-failed   { background:#f87171 }

.jc-status-label { font-size:10px; font-weight:600; margin-left:4px }
.jc-status-pending  { color:#64748b }
.jc-status-drafting { color:#facc15 }
.jc-status-draft    { color:#34d399 }
.jc-status-synced   { color:#60a5fa }
.jc-status-failed   { color:#f87171 }

/* metric badges */
.jc-good { color:#34d399; font-weight:600 }
.jc-warn { color:#facc15 }
.jc-bad  { color:#f87171 }
.jc-dim  { color:#475569 }
.jc-sep  { color:#334155; margin:0 2px }

/* title cell */
.jc-title { font-weight:600; line-height:1.35; color:#0f172a }
.jc-slug  {
  font-size:10.5px; color:#475569; margin-top:2px;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:380px;
}
.jc-slug a { color:inherit; text-decoration:none }
.jc-slug a:hover { color:#94a3b8 }

/* actions */
.jc-actions { display:flex; gap:4px; justify-content:flex-end; opacity:.6; transition:opacity .15s }
.jc-btn {
  display:inline-flex; align-items:center; gap:4px; padding:4px 10px;
  border-radius:6px; font-size:11.5px; font-weight:500; cursor:pointer;
  border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.06);
  color:#cbd5e1; transition:all .15s; white-space:nowrap;
}
.jc-btn:hover { background:rgba(255,255,255,.12); color:#f1f5f9 }
.jc-btn-primary { background:rgba(59,130,246,.2); border-color:rgba(59,130,246,.4); color:#93c5fd }
.jc-btn-primary:hover { background:rgba(59,130,246,.35) }

/* ── Batch panel ── */
#batch-panel {
  position:fixed; bottom:0; left:0; right:0; z-index:9999; display:none; flex-direction:column;
  background:#0f0f1a; border-top:1px solid rgba(124,58,237,.5);
  box-shadow:0 -8px 32px rgba(0,0,0,.6); max-height:320px;
}
#batch-panel.visible { display:flex }
#batch-panel-header {
  display:flex; align-items:center; gap:10px; padding:9px 16px; flex-shrink:0;
  background:rgba(124,58,237,.12); border-bottom:1px solid rgba(124,58,237,.2);
}
#batch-progress-bar-wrap {
  flex:1; height:6px; background:rgba(255,255,255,.08); border-radius:3px; overflow:hidden;
}
#batch-progress-bar { height:100%; background:linear-gradient(90deg,#7c3aed,#a78bfa); width:0%; transition:width .5s }
#batch-log {
  flex:1; overflow-y:auto; padding:8px 16px 12px; font-size:11.5px; font-family:monospace; line-height:1.7;
}
.blog-log-start { color:#475569 }
.blog-log-done  { color:#34d399 }
.blog-log-error { color:#f87171 }
</style>

{# ── Stats bar ── #}
<div class="jc-stats">
  <a class="jc-stat-pill{% if not active_status %} active{% endif %}"
     href="{% if active_blog %}?blog={{ active_blog }}{% else %}{{ url_for('blog_content_page') }}{% endif %}">
    <span class="n">{{ stats.total }}</span> Tổng
  </a>
  <div class="jc-divider"></div>
  <a class="jc-stat-pill{% if active_status == 'pending' %} active{% endif %}"
     href="?status=pending{% if active_blog %}&blog={{ active_blog }}{% endif %}">
    <span class="jc-dot jc-dot-pending"></span>
    <span class="n">{{ stats.pending }}</span> Pending
  </a>
  <a class="jc-stat-pill{% if active_status == 'draft' %} active{% endif %}"
     href="?status=draft{% if active_blog %}&blog={{ active_blog }}{% endif %}">
    <span class="jc-dot jc-dot-draft"></span>
    <span class="n">{{ stats.draft }}</span> Draft
  </a>
  <a class="jc-stat-pill{% if active_status == 'synced' %} active{% endif %}"
     href="?status=synced{% if active_blog %}&blog={{ active_blog }}{% endif %}">
    <span class="jc-dot jc-dot-synced"></span>
    <span class="n">{{ stats.synced }}</span> Live
  </a>
  <a class="jc-stat-pill{% if active_status == 'failed' %} active{% endif %}"
     href="?status=failed{% if active_blog %}&blog={{ active_blog }}{% endif %}">
    <span class="jc-dot jc-dot-failed"></span>
    <span class="n">{{ stats.failed }}</span> Lỗi
  </a>
  <div class="jc-divider"></div>
  <a class="jc-stat-pill{% if active_status == 'not_gen' %} active{% endif %}"
     href="?status=not_gen{% if active_blog %}&blog={{ active_blog }}{% endif %}"
     style="color:#94a3b8">
    ⏳ <span class="n">{{ stats.pending }}</span> Chưa gen
  </a>
  <a class="jc-stat-pill{% if active_status == 'generated' %} active{% endif %}"
     href="?status=generated{% if active_blog %}&blog={{ active_blog }}{% endif %}"
     style="color:#86efac">
    ✓ <span class="n">{{ (stats.draft or 0) + (stats.synced or 0) }}</span> Đã gen
  </a>
</div>

{# ── Filter bar ── #}
<div class="jc-filters">
  <span class="jc-filter-label">Loại:</span>
  <a class="jc-chip{% if not active_blog %} on{% endif %}"
     href="{% if active_status %}?status={{ active_status }}{% else %}{{ url_for('blog_content_page') }}{% endif %}">
    Tất cả
  </a>
  <a class="jc-chip{% if active_blog == 'huong-dan' %} on{% endif %}"
     href="?blog=huong-dan{% if active_status %}&status={{ active_status }}{% endif %}">
    📘 Hướng dẫn <span style="opacity:.5">{{ blog_counts.get('huong-dan', 0) }}</span>
  </a>
  <a class="jc-chip{% if active_blog == 'news' %} on{% endif %}"
     href="?blog=news{% if active_status %}&status={{ active_status }}{% endif %}">
    📰 Tin tức <span style="opacity:.5">{{ blog_counts.get('news', 0) }}</span>
  </a>
</div>

{# ── Table ── #}
{% if not jobs %}
<div style="padding:40px;text-align:center;color:var(--text-muted)">
  <div style="font-size:32px;margin-bottom:10px">📭</div>
  <div style="font-size:14px">Không có bài nào trong filter này</div>
  <div style="font-size:12px;margin-top:6px">Seed bài: <code>python _seed_blog_jobs.py</code></div>
</div>
{% else %}
<div style="border:1px solid rgba(255,255,255,.07);border-radius:10px;overflow:hidden">
<table class="jc-table">
  <thead>
    <tr>
      <th style="width:32px">#</th>
      <th style="width:80px">Status</th>
      <th>Tiêu đề · URL</th>
      <th class="r" style="width:120px" title="title · meta · số từ">Title · Meta · Words</th>
      <th class="r" style="width:60px" title="Ảnh: gom/chọn">📷</th>
      <th class="r" style="width:70px" title="SEO Quality · Readability">Q · R</th>
      <th style="width:95px">Synced</th>
      <th style="width:130px"></th>
    </tr>
  </thead>
  <tbody>
    {% set ns = namespace(cur_pillar='__none__', row_num=0) %}
    {% for j in jobs %}
    {% set tl = (j.edited_title or '')|length %}
    {% set ml = (j.edited_meta or '')|length %}
    {% set wc = j.word_count or 0 %}
    {% set slug = (j.blog_url or '')|replace('https://sintech.vn','') %}
    {% set pillar_label = j.pillar or '📂 Không có Pillar' %}

    {# ── Group header khi pillar thay đổi ── #}
    {% if pillar_label != ns.cur_pillar %}
    {% set ns.cur_pillar = pillar_label %}
    {% set ns.row_num = 0 %}
    <tr style="background:rgba(124,58,237,0.08);border-top:2px solid rgba(124,58,237,0.25)">
      <td colspan="8" style="padding:7px 12px">
        <span style="font-size:11px;font-weight:700;color:#a78bfa;text-transform:uppercase;letter-spacing:.6px">
          🏛️ {{ pillar_label }}
        </span>
        <span style="font-size:10px;color:#475569;margin-left:8px">
          {{ jobs | selectattr('pillar', 'equalto', j.pillar) | list | length }} bài
        </span>
      </td>
    </tr>
    {% endif %}
    {% set ns.row_num = ns.row_num + 1 %}

    <tr>
      {# # (số trong nhóm) #}
      <td style="color:#334155;font-size:11px;font-variant-numeric:tabular-nums">{{ ns.row_num }}</td>

      {# Status #}
      <td>
        <span class="jc-dot jc-dot-{{ j.status }}"></span>
        <span class="jc-status-label jc-status-{{ j.status }}">{{ j.status }}</span>
        {% if j.error %}
        <div style="font-size:9.5px;color:#f87171;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:90px" title="{{ j.error }}">{{ j.error[:40] }}</div>
        {% endif %}
      </td>

      {# Tiêu đề + URL #}
      <td>
        <div class="jc-title" style="font-size:13px;color:#0f172a">{{ (j.article_title or j.handle or '')[:90] }}</div>
        {% if j.keyword %}
        <div style="font-size:10px;color:#6366f1;margin-top:1px">🔑 {{ j.keyword }}</div>
        {% endif %}
        {% if j.blog_url %}
        <div class="jc-slug"><a href="{{ j.blog_url }}" target="_blank" rel="noopener" title="{{ j.blog_url }}">{{ slug }}</a></div>
        {% endif %}
      </td>

      {# Title · Meta · Words #}
      <td style="text-align:right;font-size:11px;font-variant-numeric:tabular-nums;line-height:1.9">
        {# title len #}
        {% if tl == 0 %}<span class="jc-dim">—</span>
        {% elif 45 <= tl <= 61 %}<span class="jc-good">{{ tl }}c</span>
        {% elif tl > 61 %}<span class="jc-bad">{{ tl }}c</span>
        {% else %}<span class="jc-warn">{{ tl }}c</span>{% endif %}
        <span class="jc-sep">·</span>
        {# meta len #}
        {% if ml == 0 %}<span class="jc-dim">—</span>
        {% elif 140 <= ml <= 160 %}<span class="jc-good">{{ ml }}c</span>
        {% elif ml > 160 %}<span class="jc-bad">{{ ml }}c</span>
        {% else %}<span class="jc-warn">{{ ml }}c</span>{% endif %}
        <br>
        {# words #}
        {% if wc == 0 %}<span class="jc-dim">—</span>
        {% elif wc >= 1500 %}<span class="jc-good">{{ wc }}w</span>
        {% elif wc >= 600 %}<span class="jc-warn">{{ wc }}w</span>
        {% else %}<span class="jc-bad">{{ wc }}w</span>{% endif %}
      </td>

      {# Ảnh #}
      <td style="text-align:right;font-size:11px">
        {% if j.img_count %}
          <span title="{{ j.img_selected }} đã chọn / {{ j.img_count }} đã gom">
            {{ j.img_count }}{% if j.img_selected %}<span class="jc-good">/{{ j.img_selected }}</span>{% endif %}
          </span>
        {% else %}<span class="jc-dim">—</span>{% endif %}
      </td>

      {# Q · R #}
      <td style="text-align:right;font-size:11px;line-height:1.9">
        {% set qs = j.quality_score %}
        {% if not qs %}<span class="jc-dim">—</span>
        {% elif qs >= 80 %}<span class="jc-good">{{ qs }}</span>
        {% elif qs >= 60 %}<span class="jc-warn">{{ qs }}</span>
        {% else %}<span class="jc-bad">{{ qs }}</span>{% endif %}
        <span class="jc-sep">·</span>
        {% set rs = j.readability_score %}
        {% if not rs %}<span class="jc-dim">—</span>
        {% elif rs >= 60 %}<span class="jc-good">{{ rs }}</span>
        {% elif rs >= 40 %}<span class="jc-warn">{{ rs }}</span>
        {% else %}<span class="jc-bad">{{ rs }}</span>{% endif %}
        {% if j.click %}
        <br><span style="color:#3b82f6;font-size:10px" title="GSC clicks">{{ j.click }}↗</span>
        {% endif %}
      </td>

      {# Synced #}
      <td style="font-size:10.5px;color:#475569">
        {{ j.synced_at[:16] if j.synced_at else '—' }}
      </td>

      {# Actions #}
      <td>
        <div class="jc-actions">
          <a href="{{ url_for('blog_content_detail_page', job_id=j.id) }}" class="jc-btn">✏️ Sửa</a>
          {% if j.edited_title and j.edited_body_html %}
          <button class="jc-btn jc-btn-primary" onclick="syncInline({{ j.id }}, this)">🚀</button>
          {% endif %}
        </div>
      </td>
    </tr>
    {% endfor %}{# end jobs loop #}
  </tbody>
</table>
</div>
<div style="padding:10px 12px;font-size:11px;color:#334155;text-align:right">
  {{ jobs|length }} bài đang hiển thị
</div>
{% endif %}

{# ── Batch gen panel ── #}
<div id="batch-panel">
  <div id="batch-panel-header">
    <span id="batch-status-text" style="font-size:12.5px;font-weight:600;color:#c4b5fd;min-width:180px">▶ Đang gen…</span>
    <span id="batch-count" style="font-size:11.5px;color:#64748b;min-width:60px">0 / 0</span>
    <div id="batch-progress-bar-wrap"><div id="batch-progress-bar"></div></div>
    <button class="jc-btn" onclick="stopBatch()" id="btn-stop"
            style="background:rgba(239,68,68,.15);color:#f87171;border-color:rgba(239,68,68,.35)">⏹ Dừng</button>
    <button class="jc-btn" onclick="closeBatchPanel()" id="btn-close-panel" style="display:none">✕ Đóng</button>
  </div>
  <div id="batch-log"></div>
</div>

<script>
const _BATCH_KEY = 'sintech_batch_stream';
let _batchStreamId = null;
let _batchEvtSource = null;
let _batchEventIdx = 0;   // offset events đã nhận, dùng khi reconnect

// ── Khi trang load: check localStorage xem có batch đang chạy không ──
document.addEventListener('DOMContentLoaded', () => {
  const saved = localStorage.getItem(_BATCH_KEY);
  if (!saved) return;
  try {
    const {stream_id, total, started} = JSON.parse(saved);
    // Bỏ qua nếu đã hơn 2 giờ
    if (Date.now() - started > 7200000) { localStorage.removeItem(_BATCH_KEY); return; }
    // Check server còn stream không
    fetch('/blog-content/batch-gen/status/' + stream_id)
      .then(r => r.json())
      .then(s => {
        if (!s.active) { localStorage.removeItem(_BATCH_KEY); return; }
        // Reconnect: nhận lại toàn bộ events từ đầu
        _batchStreamId = stream_id;
        openBatchPanel(total, /*reconnect=*/true);
        listenBatchStream(stream_id, total, 0);
        document.getElementById('btn-batch').disabled = true;
      })
      .catch(() => localStorage.removeItem(_BATCH_KEY));
  } catch(e) { localStorage.removeItem(_BATCH_KEY); }
});

// ── Warn khi rời trang đang gen ──
window.addEventListener('beforeunload', e => {
  if (_batchStreamId && _batchEvtSource) {
    e.preventDefault();
    e.returnValue = 'Batch gen đang chạy — rời trang vẫn gen tiếp, quay lại sẽ thấy progress.';
  }
});

function startBatchGen() {
  const full = confirm(
    'Chọn kiểu gen cho tất cả bài CHƯA GEN:\n\n' +
    'OK  →  ✨ Gen đầy đủ: research outline + viết bài (~3-4 phút/bài)\n' +
    'Cancel  →  🤖 Gen nhanh: viết bài không research (~1-2 phút/bài)'
  );
  const mode = full ? 'full' : 'quick';
  if (!full && !confirm('🤖 Gen nhanh cho tất cả bài chưa gen?')) return;

  fetch('/blog-content/batch-gen', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({mode, status: 'not_gen'})
  })
  .then(r => r.json())
  .then(d => {
    if (!d.ok) { alert('❌ ' + d.error); return; }
    _batchStreamId = d.stream_id;
    // Lưu vào localStorage để auto-reconnect nếu chuyển trang
    localStorage.setItem(_BATCH_KEY, JSON.stringify({
      stream_id: d.stream_id, total: d.total, started: Date.now()
    }));
    openBatchPanel(d.total);
    listenBatchStream(d.stream_id, d.total, 0);
    document.getElementById('btn-batch').disabled = true;
  })
  .catch(e => alert('❌ ' + e));
}

function openBatchPanel(total, reconnect = false) {
  const panel = document.getElementById('batch-panel');
  panel.classList.add('visible');
  if (!reconnect) document.getElementById('batch-log').innerHTML = '';
  document.getElementById('batch-count').textContent = '0 / ' + total;
  document.getElementById('batch-progress-bar').style.width = '0%';
  document.getElementById('batch-progress-bar').style.background = 'linear-gradient(90deg,#7c3aed,#a78bfa)';
  document.getElementById('batch-status-text').textContent = reconnect ? '🔄 Đang kết nối lại…' : '▶ Đang gen…';
  document.getElementById('btn-stop').style.display = '';
  document.getElementById('btn-stop').disabled = false;
  document.getElementById('btn-close-panel').style.display = 'none';
}

function closeBatchPanel() {
  document.getElementById('batch-panel').classList.remove('visible');
}

function stopBatch() {
  if (!_batchStreamId) return;
  fetch('/blog-content/batch-gen/stop/' + _batchStreamId, {method: 'POST'});
  document.getElementById('batch-status-text').textContent = '⏸ Đang dừng…';
  document.getElementById('btn-stop').disabled = true;
}

function _batchFinished() {
  _batchStreamId = null;
  _batchEvtSource = null;
  localStorage.removeItem(_BATCH_KEY);
  document.getElementById('btn-batch').disabled = false;
}

function listenBatchStream(streamId, total, fromIdx) {
  if (_batchEvtSource) _batchEvtSource.close();
  _batchEventIdx = fromIdx;
  const url = `/blog-content/batch-gen/stream/${streamId}?from=${fromIdx}`;
  const es = new EventSource(url);
  _batchEvtSource = es;
  const log = document.getElementById('batch-log');
  const bar = document.getElementById('batch-progress-bar');
  const counter = document.getElementById('batch-count');

  es.onmessage = function(e) {
    const d = JSON.parse(e.data);
    if (d.type === 'ping') return;
    _batchEventIdx++;
    const pct = d.total ? Math.round((d.idx || d.done || 0) / d.total * 100) : 0;

    if (d.type === 'start') {
      // Nếu đã có row (reconnect) thì skip tạo mới
      if (!document.getElementById('blog-log-' + d.id)) {
        const row = document.createElement('div');
        row.className = 'blog-log-start';
        row.id = 'blog-log-' + d.id;
        row.textContent = `⏳  [${d.idx}/${d.total}]  ${d.title}`;
        log.appendChild(row);
      }
      log.scrollTop = log.scrollHeight;
      counter.textContent = d.idx + ' / ' + d.total;
      document.getElementById('batch-status-text').textContent = `▶ Gen bài #${d.id}…`;
    } else if (d.type === 'done') {
      let row = document.getElementById('blog-log-' + d.id);
      if (!row) { row = document.createElement('div'); row.id = 'blog-log-' + d.id; log.appendChild(row); }
      row.className = 'blog-log-done';
      row.textContent = `✅  [${d.idx}/${d.total}]  ${d.title}`;
      bar.style.width = pct + '%';
      counter.textContent = d.idx + ' / ' + d.total;
      log.scrollTop = log.scrollHeight;
    } else if (d.type === 'error') {
      let row = document.getElementById('blog-log-' + d.id);
      if (!row) { row = document.createElement('div'); row.id = 'blog-log-' + d.id; log.appendChild(row); }
      row.className = 'blog-log-error';
      row.textContent = `❌  [${d.idx}/${d.total}]  ${d.title}  —  ${d.error}`;
      log.scrollTop = log.scrollHeight;
    } else if (d.type === 'finish') {
      es.close();
      bar.style.width = '100%';
      bar.style.background = '#34d399';
      document.getElementById('batch-status-text').textContent = `🎉 Xong! ${d.done}/${d.total} bài`;
      document.getElementById('btn-stop').style.display = 'none';
      document.getElementById('btn-close-panel').style.display = '';
      _batchFinished();
      setTimeout(() => location.reload(), 2500);
    } else if (d.type === 'stopped') {
      es.close();
      document.getElementById('batch-status-text').textContent = `⏹ Dừng — đã gen ${d.done}/${d.total}`;
      document.getElementById('btn-stop').style.display = 'none';
      document.getElementById('btn-close-panel').style.display = '';
      _batchFinished();
    }
  };

  es.onerror = function() {
    // Không đóng — SSE sẽ tự retry theo retry: 3000 đã set phía server
    document.getElementById('batch-status-text').textContent = '🔄 Mất kết nối — đang reconnect…';
  };
}

async function syncInline(id, btn) {
  if (!confirm(`🚀 Push bài #${id} lên Haravan?\nChỉ đăng khi đã duyệt nội dung — bài sẽ public ngay.`)) return;
  const orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '⏳';
  try {
    const r = await fetch(`/blog-content/${id}/sync`, {method: 'POST'});
    const d = await r.json();
    if (d.ok) {
      btn.innerHTML = '✅';
      setTimeout(() => location.reload(), 1200);
    } else {
      btn.innerHTML = orig; btn.disabled = false;
      alert('❌ ' + (d.error || 'Lỗi push'));
    }
  } catch (e) { btn.innerHTML = orig; btn.disabled = false; alert('❌ ' + e); }
}
</script>

